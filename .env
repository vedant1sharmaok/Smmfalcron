# ============================================================
# SMM FALCRON — ENVIRONMENT VARIABLES
#
# LOCAL: fill in below
# RENDER: set these in the Render dashboard → Environment
#         .env is NOT loaded in Docker on Render
#
# Generate keys: python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ── DATABASE (Supabase session pooler, port 5432) ────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_SYNC=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST.pooler.supabase.com:5432/postgres

# ── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/0
REDIS_WORKER_URL=redis://:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/1

# ── ENCRYPTION (3 separate 64-hex-char keys) ─────────────────────────────────
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ── CUSTOMER BOT ─────────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_CUSTOMER_BOT_TOKEN
BOT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_CHARS
BOT_WEBHOOK_URL=https://YOUR_APP.onrender.com/bot/webhook

# ── ADMIN BOT (create a separate bot for admin panel) ────────────────────────
# Create a NEW bot via @BotFather — do NOT reuse BOT_TOKEN
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN
ADMIN_BOT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_CHARS
# Comma-separated Telegram IDs of people who can use the admin bot
ADMIN_TELEGRAM_IDS=YOUR_TELEGRAM_ID,ANOTHER_ADMIN_ID

# ── SUPPORT ───────────────────────────────────────────────────────────────────
# @username shown in the Support menu (without @)
SUPPORT_USERNAME=your_support_username

# ── ADMIN JWT (REST API) ──────────────────────────────────────────────────────
ADMIN_JWT_SECRET=REPLACE_WITH_64_HEX_CHARS

# ── RAZORPAY ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ── STRIPE ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=inr

# ── S3 BACKUPS ────────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=YOUR_BUCKET
BACKUP_S3_ENDPOINT=https://YOUR_ENDPOINT
BACKUP_S3_ACCESS_KEY=YOUR_KEY
BACKUP_S3_SECRET_KEY=YOUR_SECRET
BACKUP_RETENTION_DAILY=30

# ── FX ────────────────────────────────────────────────────────────────────────
USD_TO_INR_RATE=83.00
FIXER_API_KEY=

# ── MONITORING ────────────────────────────────────────────────────────────────
METRICS_BEARER_TOKEN=REPLACE_WITH_RANDOM_TOKEN
SENTRY_DSN=
LOG_LEVEL=INFO

# ── APPLICATION ───────────────────────────────────────────────────────────────
APP_ENV=production
DOMAIN=https://YOUR_APP.onrender.com
APP_WORKERS=1
