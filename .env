# ============================================================
# SMM PLATFORM — ENVIRONMENT VARIABLES
#
# LOCAL DEV: fill in values here and run locally.
# RENDER PRODUCTION: set these as env vars in the Render dashboard.
# DO NOT commit this file with real credentials to git.
# ============================================================

# ───────────────────────────────────────────────────────────
# DATABASE (Supabase session pooler)
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres
# Get from: Supabase dashboard → Settings → Database → Connection string → Session pooler
# ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL_SYNC=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ───────────────────────────────────────────────────────────
# REDIS
# ───────────────────────────────────────────────────────────
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/0
REDIS_WORKER_URL=redis://:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/1
REDIS_POOL_SIZE=20

# ───────────────────────────────────────────────────────────
# ENCRYPTION (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
# ───────────────────────────────────────────────────────────
ENCRYPTION_KEY=YOUR_64_HEX_CHAR_KEY
CONFIG_ENCRYPTION_KEY=YOUR_64_HEX_CHAR_KEY
BACKUP_ENCRYPTION_KEY=YOUR_64_HEX_CHAR_KEY

# ───────────────────────────────────────────────────────────
# TELEGRAM
# ───────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET_MIN_32_CHARS
BOT_WEBHOOK_URL=https://YOUR_RENDER_APP.onrender.com/bot/webhook
TELEGRAM_INIT_DATA_MAX_AGE=300

# ───────────────────────────────────────────────────────────
# ADMIN JWT (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
# ───────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET

# ───────────────────────────────────────────────────────────
# RAZORPAY
# ───────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ───────────────────────────────────────────────────────────
# STRIPE
# ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=inr

# ───────────────────────────────────────────────────────────
# S3 / BACKUPS
# ───────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=YOUR_S3_BUCKET
BACKUP_S3_ENDPOINT=https://YOUR_S3_ENDPOINT
BACKUP_S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
BACKUP_S3_SECRET_KEY=YOUR_S3_SECRET_KEY
BACKUP_RETENTION_DAILY=30

# ───────────────────────────────────────────────────────────
# FX
# ───────────────────────────────────────────────────────────
USD_TO_INR_RATE=83.00
FIXER_API_KEY=

# ───────────────────────────────────────────────────────────
# MONITORING
# ───────────────────────────────────────────────────────────
METRICS_BEARER_TOKEN=YOUR_RANDOM_METRICS_TOKEN
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_CH_CRITICAL=0

# ───────────────────────────────────────────────────────────
# APPLICATION
# ───────────────────────────────────────────────────────────
APP_ENV=production
DOMAIN=https://YOUR_RENDER_APP.onrender.com
APP_WORKERS=1

# ───────────────────────────────────────────────────────────
# WORKERS
# ───────────────────────────────────────────────────────────
WORKER_ORDER_MONITOR_INTERVAL=120
WORKER_PAYMENT_RECONCILER_INTERVAL=900
