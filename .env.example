# ============================================================================
# FALARON — environment. Copy to .env. NEVER commit .env or paste it in chats.
# ============================================================================

# ---- required ---------------------------------------------------------------
# from @BotFather
BOT_TOKEN=
# your numeric Telegram id (from @userinfobot)
OWNER_TELEGRAM_ID=

# ---- docker-compose deployment (production) ---------------------------------
# DNS A/AAAA record must point at this server before first start
DOMAIN=shop.example.com
# long random string: openssl rand -hex 24
POSTGRES_PASSWORD=
# Encrypts provider API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP. Lose it and stored provider keys become unreadable.
SECRET_KEY=

# ---- public links (required in production; users must accept real documents) -
TERMS_URL=
PRIVACY_URL=
# e.g. https://t.me/your_support
SUPPORT_URL=
BRAND_NAME=FALARON
# without @
BOT_USERNAME=

# ---- payments ----------------------------------------------------------------
# razorpay = automatic, verified via signed webhooks (recommended)
# manual   = you verify money yourself and run /confirmpay in the bot
PAYMENT_GATEWAY=razorpay
ENABLE_MOCK_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# the secret you type when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# INR 100
MIN_DEPOSIT_PAISE=10000
# INR 50,000
MAX_DEPOSIT_PAISE=5000000

# ---- SMM provider (optional here; you can also use `python -m app.cli add-provider`) ----
# https://panel.example.com/api/v2
SMM_API_URL=
SMM_API_KEY=

# ---- business -----------------------------------------------------------------
GLOBAL_MARKUP_PERCENT=25
MIN_MARGIN_PERCENT=5
# free credit per new account. 0 in production unless you really mean it.
WELCOME_BONUS_PAISE=0

# ---- tuning (defaults are fine) -------------------------------------------------
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=90
ORDER_RATE_LIMIT_PER_MINUTE=12

# ---- local development only (no Docker) -----------------------------------------
# APP_ENV=development
# DATABASE_URL=sqlite+aiosqlite:///./falaron.db
# PAYMENT_GATEWAY=mock
# ENABLE_MOCK_PAYMENTS=true
